{
    "name": "misaf/vendra-affiliate",
    "description": "Affiliate and referral management system with commission tracking and user referral capabilities",
    "keywords": [
        "laravel",
        "filamentphp",
        "affiliate"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "filament/filament": "^5.6.8",
        "illuminate/support": "^13.0",
        "misaf/vendra-support": "^1.2",
        "misaf/vendra-transaction": "^1.2",
        "misaf/vendra-user": "^1.2",
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.93.1",
        "spatie/laravel-queueable-action": "^2.17"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.10.0",
        "laravel/boost": "^2.4.12",
        "laravel/pint": "^1.29.3",
        "misaf/vendra-testing": "^1.2",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.4",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7.5",
        "pestphp/pest-plugin-arch": "^4.0.2",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/extension-installer": "^1.4.3"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraAffiliate\\": "src/",
            "Misaf\\VendraAffiliate\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraAffiliate\\Database\\Factories\\": "database/factories/",
            "Misaf\\VendraAffiliate\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraAffiliate\\Providers\\AffiliateServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "suggest": {
        "misaf/vendra-tagger": "Install this in the host application to assign typed tags to affiliates."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
